# Copy to .env.local for local development and scripts (npm run dev, db:migrate, db:verify).
# .env.local is git-ignored. Never commit real values. Server-only: nothing here reaches the browser.

APP_ENV=development
LOG_LEVEL=info

# Neon connection string. For local work use a Neon development branch, not production:
#   neon connection-string <branch> --project-id <project-id> --pooled
DATABASE_URL=

# Optional. At least 32 characters; unlocks GET /api/health?checks=db (header x-health-token).
#   openssl rand -hex 32
HEALTH_CHECK_TOKEN=
