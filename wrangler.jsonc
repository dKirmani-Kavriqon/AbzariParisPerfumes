{
  // One Worker per client per environment. For another client, copy this file and change
  // `name`, `account_id` and the self-reference service below (see docs/CLIENT_SETUP.md).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "abzari-paris-preview",
  "account_id": "558c396a78e9cb79e07d05f9f24314b3",
  "main": "worker.ts",
  // worker.ts imports server modules directly; see src/server/server-only-worker.ts.
  "alias": { "server-only": "./src/server/server-only-worker.ts" },
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "abzari-paris-preview" }],

  // Non-secret settings. Secrets (DATABASE_URL, HEALTH_CHECK_TOKEN, later payment and email
  // keys) are set with `wrangler secret put` and never written here.
  "vars": {
    "APP_ENV": "preview",
    "LOG_LEVEL": "info",
    // Admin access through Cloudflare Access (application "Abzari Paris admin (preview)", covering
    // /admin and /api/admin). Not secret. The admin email allowlist is a Worker secret (ADMIN_EMAILS).
    "ADMIN_ACCESS_TEAM_DOMAIN": "tiny-cloud-aadc.cloudflareaccess.com",
    "ADMIN_ACCESS_AUD": "1f2c2306874bd1919245220f26cc067389bb08abe2c478fc7e8089f291c04acd"
  },

  // Product image uploads (private bucket; files are served by this Worker at /media).
  "r2_buckets": [{ "binding": "MEDIA_BUCKET", "bucket_name": "abzari-paris-media" }],

  // Workers Logs: included in the free plan (with a daily event allowance).
  "observability": { "enabled": true },

  // Served at https://abzari-paris-preview.<account-subdomain>.workers.dev. No custom domain
  // or routes until launch.
  "workers_dev": true,
  "preview_urls": false
}
